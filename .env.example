# Copy this file to .env (same folder) and fill in your values. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kuala_Lumpur

# Database. Without this line the app uses SQLite (wisepaymentdashboard/db.sqlite3).
# To use PostgreSQL instead, remove the # and fill in your role, password and database:
# DATABASE_URL=postgres://wise_app:your-password@localhost:5432/wise_dashboard

# Wise: a personal API token from https://wise-sandbox.com
# (Your Account → Connect and manage apps → API tokens, full access)
WISE_API_TOKEN=
WISE_BASE_URL=https://api.wise-sandbox.com
WISE_API_VERSION=2026Q4
# Optional: which Wise profile the dashboard uses. Without it, the first BUSINESS profile is used.
# The overview page lists every profile's ID and country.
# WISE_PROFILE_ID=

# Stripe: the SECRET key of a Stripe sandbox (starts with sk_test_).
# Dashboard → account picker → Sandboxes → open your sandbox → Developers → API keys
STRIPE_SECRET_KEY=
STRIPE_API_VERSION=2026-09-30.endive
